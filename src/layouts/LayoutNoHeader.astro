---
import BaseHead from "@shared/components/BaseHead.astro";
import ThemeIcon from "@shared/components/ThemeIcon.astro";
import AdBlockerOverlay from "@shared/components/AdBlocker/AdBlockerOverlay";

const pathName = Astro.url.pathname;
export const prerender = true;
---

<html lang="en">
  <head>
    {
      pathName === "/" ? (
        <BaseHead />
      ) : (
        <BaseHead
          title={
            pathName.charAt(1).toUpperCase() + pathName.slice(2).split("/")[0]
          }
        />
      )
    }
  </head>
  <body>
    <ThemeIcon />
    <AdBlockerOverlay client:load />
    <main>
      <slot />
    </main>
  </body>
</html>
